# Clerk — get these from https://dashboard.clerk.com (Create app → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Supabase — Project → Settings → API. Leave blank to run on mock data.
# Run glory-app/supabase/schema.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for Stripe onboarding return links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Connect — https://dashboard.stripe.com/apikeys
# Leave blank to keep payments in demo mode.
STRIPE_SECRET_KEY=
# From `stripe listen` or the dashboard webhook endpoint:
STRIPE_WEBHOOK_SECRET=

# Resend — waitlist confirmation emails (https://resend.com/api-keys).
# Leave blank to skip sending (signups still record).
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=GLORY <hello@yourdomain.com>
